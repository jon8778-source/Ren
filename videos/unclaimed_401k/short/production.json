 "audio_cues": [
  {
   "start": 0.0,
   "end": 2.14,
   "text": "Maya saved twelve dollars last night."
  },
  {
   "start": 2.64,
   "end": 8.58,
   "text": "She canceled a subscription she barely used, checked the confirmation email, and felt pretty good about it."
  },
  {
   "start": 9.24,
   "end": 11.08,
   "text": "Then she opened her work benefits portal."
  },
  {
   "start": 11.72,
   "end": 14.78,
   "text": "There was a number sitting in there that made the subscription look tiny."
  },
  {
   "start": 14.867,
   "end": 16.22,
   "text": "One hundred dollars a month."
  },
  {
   "start": 16.348,
   "end": 18.12,
   "text": "Twelve hundred dollars a year."
  },
  {
   "start": 18.56,
   "end": 23.36,
   "text": "Her employer was willing to put that into her retirement account, but only if she made one change."
  },
  {
   "start": 23.63,
   "end": 25.497,
   "text": "But Maya's been putting in two percent."
  },
  {
   "start": 25.79,
   "end": 29.85,
   "text": "That's twelve hundred a year from her, with twelve hundred matched by work."
  },
  {
   "start": 30.12,
   "end": 32.12,
   "text": "She's been getting half the match she could receive."
  },
  {
   "start": 32.58,
   "end": 34.94,
   "text": "The missing half is another twelve hundred dollars a year."
  },
  {
   "start": 35.21,
   "end": 44.93,
   "text": "Leave it unclaimed for ten more years, and that's twelve thousand dollars of employer contributions alone, before considering any investment growth, changes in salary, or changes to the plan."
  },
  {
   "start": 45.2,
   "end": 45.58,
   "text": "I'm Ren."
  },
  {
   "start": 45.84,
   "end": 49.3,
   "text": "And sometimes the next useful money move isn't earning more."
  },
  {
   "start": 49.84,
   "end": 52.06,
   "text": "It's noticing what's already on the table."
  },
  {
   "start": 52.72,
   "end": 55.32,
   "text": "Check out the Money Leak Audit Workbook in the description."
  },
  {
   "start": 55.98,
   "end": 58.54,
   "text": "Educational only, not financial advice."
  }
 ]
