  {
   "id": "h01",
   "section": "short-frank",
   "text": "This is Frank.",
   "refs": [],
   "start": 0.41,
   "end": 1.488,
   "chunk": 0
  },
  {
   "id": "h02",
   "section": "short-frank",
   "text": "Frank just died at eighty-five, with more than two million dollars in the bank.",
   "refs": [
    "frank.end_age",
    "=2000000"
   ],
   "start": 1.938,
   "end": 6.382,
   "chunk": 0
  },
  {
   "id": "h03",
   "section": "short-frank",
   "text": "On his desk is a travel brochure for Italy.",
   "refs": [],
   "start": 6.832,
   "end": 9.673,
   "chunk": 0
  },
  {
   "id": "h04",
   "section": "short-frank",
