  {
   "id": "b01",
   "section": "short-bea",
   "text": "And then there's Bea.",
   "refs": [],
   "start": 0.41,
   "end": 1.627,
   "chunk": 0
  },
  {
   "id": "b02",
   "section": "short-bea",
