{
 "settings": {
  "engine": "kokoro-82m (q8 onnx)",
  "blend": {
   "am_michael": 0.5,
   "am_eric": 0.5
  },
  "speed": 0.93,
  "gap_s": 0.42,
  "section_gap_s": 0.8,
