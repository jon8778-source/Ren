   ],
   "start": 4.311,
   "end": 10.516,
   "chunk": 0
  },
  {
   "id": "b06",
   "section": "short-buckets",
   "text": "Some things fit anywhere.",
   "refs": [],
   "start": 10.966,
   "end": 12.506,
   "chunk": 0
  },
  {
   "id": "b07",
   "section": "short-buckets",
   "text": "A cooking class works at thirty or seventy.",
