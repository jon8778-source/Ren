    {
      "id": "s004",
      "title": "Passage 4",
      "text": "Useful idea. Dangerous if you treat a projection like a promise. Here\u2019s a made-up example. You\u2019re forty, aiming to retire at sixty-five, with four hundred thousand dollars invested for retirement. Suppose a separate spending plan suggests you need one million dollars invested when you retire, measured in today\u2019s purchasing power. That target is just for this example; it isn\u2019t a universal retirement number.",
      "settings": {
        "space": "Qwen/Qwen3-TTS",
        "endpoint": "/generate_voice_clone",
        "model": "Qwen/Qwen3-TTS-12Hz-1.7B-Base",
        "model_size": "1.7B",
        "language": "English",
        "use_xvector_only": true,
        "reference": "Audio/ren_reference.wav",
        "transcript": "Audio/ren_reference.txt",
        "other_generation_parameters": "unchanged public Space defaults",
        "reference_sha256": "78de4bd45743554f15ce32d8db39deaf1c0b1a9a5cd69fabb6d637dff323ed1c",
        "transcript_sha256": "46de9b48af8de666aa7275169f1f95fab8a398de3198c7d2fa51edbe22fb8451"
